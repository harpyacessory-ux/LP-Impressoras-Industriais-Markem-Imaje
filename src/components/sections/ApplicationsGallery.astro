---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 27/10/2026 (docs/BRIEFING.md): cabeçalho centrado
 * com o H2 em duas linhas, 4 cards com foto 8:5 em cima e corpo verde-escuro (título, frase e
 * seta), e uma faixa "Encontre a solução ideal…" com CTA no fim. O card inteiro é o CTA.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor, reaplique a variante.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <div class="mx-auto max-w-4xl text-center">
    <span class="inline-flex items-center gap-3.5 font-sans text-[12px] font-semibold tracking-[0.3em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-1 w-10 rounded-full bg-accent-orange"></span>
      {applications.eyebrow}
    </span>
    <h2 class="mt-4 font-display text-[2.1rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-5xl lg:text-[3.6rem]">
      {/* Duas linhas fixas a partir do tablet; no celular o título quebra sozinho. */}
      {applications.titleLines.map((line) => (
        <span class="sm:block">{line} </span>
      ))}
    </h2>
    <p class="mt-4 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px] lg:text-lg">
      {applications.text}
    </p>
  </div>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {applications.items.map((app) => (
      <li>
        <button
          type="button"
          data-cta={`aplicacoes-${app.id}`}
          class="btn-slave-whats app-card group flex h-full w-full flex-col overflow-hidden rounded-2xl bg-primary-dark text-left shadow-[0_22px_44px_-28px_rgba(1,36,34,0.65)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(1,36,34,0.75)]"
        >
          <span class="block aspect-[8/5] overflow-hidden bg-primary-dark-900">
            <Image
              src={app.photo.src}
              alt={app.photo.alt}
              format="webp"
              widths={[400]}
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
            />
          </span>
          <span class="app-card__body flex flex-1 flex-col px-6 pt-5 pb-6">
            <span class="font-display text-xl leading-snug font-bold text-neutral-light lg:text-[1.35rem]">
              {app.label}
            </span>
            <span class="mt-2.5 flex flex-1 items-center justify-between gap-3">
              <span class="font-sans text-[14px] leading-relaxed text-neutral-light/85">
                {app.description}
              </span>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light transition-transform duration-300 group-hover:translate-x-0.5">
                <Icon name="arrow-right" class="size-5" />
              </span>
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>

  <div class="mt-12 flex flex-col gap-3 border-t border-ink/10 pt-7 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p class="font-sans text-[16px] text-ink-soft sm:text-[17px]">{applications.help.text}</p>
    <button
      type="button"
      data-cta="aplicacoes-cta"
      class="btn-slave-whats group inline-flex shrink-0 items-center gap-3 self-start font-sans text-[16px] font-bold text-primary-dark transition-colors duration-200 hover:text-accent-orange sm:self-auto sm:text-[17px]"
    >
      {applications.help.cta}
      <Icon
        name="arrow-right"
        class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    </button>
  </div>
</Section>

<style>
  /* Corpo verde-escuro do card, com um brilho sutil no topo. */
  .app-card__body {
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.06) 0%, transparent 60%),
      linear-gradient(165deg, var(--color-primary-dark) 0%, var(--color-primary-dark-900) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
