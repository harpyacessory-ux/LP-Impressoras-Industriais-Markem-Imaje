---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * Bloco navy em largura total (por isso `container={false}`) com 5 cards
 * sobrepostos à sua base. É a segunda seção que carrega bloco navy: o respiro
 * escuro da segunda metade, imediatamente antes da conversão.
 *
 * VARIANTE LOCAL — Print Master, mockup de 27/10/2026 (docs/BRIEFING.md): a cena (fundo escuro
 * à esquerda, equipamentos e linha de envase à direita) cobre o bloco inteiro e substitui a
 * pessoa recortada; H2 maior com barra verde, botão arredondado e cards com ícone em caixa
 * menta, sem corte de texto. `npm run compose` sobrescreve este arquivo: reaplique ao recompor.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false} class="relative">
  {/* Bloco escuro em largura total, com a cena por trás */}
  <div class="why-hero relative overflow-hidden bg-hero-deep">
    <div class="why-scene">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1024, 1600, 1935]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="why-scene-img"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    <div class="relative z-[2] mx-auto w-full max-w-page px-6 pt-12 pb-10 lg:px-10 lg:pt-24 lg:pb-36">
      <div class="max-w-xl lg:max-w-[47%]">
        <span class="relative inline-flex items-center pl-5 font-sans text-[12.5px] font-semibold tracking-[0.2em] text-neutral-light uppercase">
          <span
            aria-hidden="true"
            class="absolute -top-2 left-0 size-[18px] border-t-2 border-l-2 border-brand-leaf"
          ></span>
          {why.eyebrow}
        </span>
        <h2 class="mt-4 font-display text-[2.2rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-5xl xl:text-[3.6rem]">
          {why.titleLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h2>

        <span aria-hidden="true" class="mt-6 block h-1 w-24 rounded-full bg-brand-leaf"></span>

        <p class="mt-6 max-w-[36rem] font-sans text-base leading-relaxed text-neutral-light/90 sm:text-lg xl:text-[19px]">
          {why.text}
        </p>

        <button
          type="button"
          data-cta="diferenciais-cta"
          class="btn-slave-whats mt-8 inline-flex w-full items-center justify-center gap-3 rounded-lg bg-brand-emerald px-8 py-4 font-sans text-[17px] font-bold text-neutral-light shadow-[0_18px_40px_-18px_rgba(26,165,122,0.9)] transition-colors duration-200 hover:bg-accent-orange sm:w-auto"
        >
          {cta.primary}
          <Icon name="arrow-right" class="size-5 shrink-0" />
        </button>
      </div>
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco escuro */}
  <div class="relative z-10 mx-auto -mt-16 max-w-page px-6 lg:px-10" data-why>
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason) => (
        <li class="why-card group relative flex w-[78%] shrink-0 snap-start flex-col gap-3 rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-5 lg:p-4 xl:p-5 shadow-[0_24px_48px_-26px_rgba(1,36,34,0.45)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-brand-leaf/50 hover:shadow-[0_32px_60px_-28px_rgba(1,36,34,0.55)] sm:w-[44%] lg:w-auto">
          <div class="flex items-center gap-2.5">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#e8f5ef] text-primary-dark transition-colors duration-300 group-hover:bg-brand-leaf/15">
              <Icon name={reason.icon} class="size-[18px]" />
            </span>
            <h3 class="font-display text-[14.5px] leading-[1.25] font-bold text-ink">
              {reason.title}
            </h3>
          </div>
          <p class="font-sans text-[13.5px] leading-relaxed text-ink-soft">{reason.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  .why-hero {
    isolation: isolate;
  }

  /* Mobile: a cena vem abaixo do texto, recortada nos equipamentos e fundida ao bloco. */
  .why-scene {
    position: relative;
    order: 2;
    height: 340px;
    mask-image: linear-gradient(to bottom, transparent 0, black 30%);
  }

  .why-scene :global(.why-scene-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% center;
  }

  .why-hero {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    /* Desktop: a cena cobre o bloco inteiro, presa ao alto e à direita, como no mockup. */
    .why-hero {
      display: block;
      min-height: 600px;
    }

    .why-scene {
      position: absolute;
      inset: 0;
      z-index: 1;
      height: auto;
      mask-image: none;
    }

    .why-scene :global(.why-scene-img) {
      object-position: right top;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card * {
      transition: none !important;
    }

    .why-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
