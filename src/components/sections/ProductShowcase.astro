---
/**
 * Vitrine de produtos — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 26/10/2026 (docs/BRIEFING.md): os grupos viram
 * abas acessíveis, com a contagem de modelos ao lado; cada card tem a foto grande em cima e um
 * painel verde-escuro com a marca, o modelo em destaque e "Ver equipamento"; uma faixa de ajuda
 * fecha a seção. `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor,
 * reaplique a variante.
 *
 * Sem grupos, a vitrine continua uma grade só, sem abas.
 *
 * As duas invariantes do conteúdo são verificadas aqui, no build, porque o
 * `contract` do manifesto não expressa condição entre itens: descrição é tudo ou
 * nada, e todo item de vitrine agrupada aponta para um grupo existente.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { showcase, type ShowcaseGroup, type ShowcaseItem } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Tipos largos de propósito: o `as const` dos dados deixa `groups: []` como `readonly []`
// e os ids como literais, e as verificações abaixo virariam `never` na vitrine sem grupos.
const { groups, items }: { groups: readonly ShowcaseGroup[]; items: readonly ShowcaseItem[] } =
  showcase

const described = items.filter((item) => item.description.trim()).length
if (described !== 0 && described !== items.length) {
  throw new Error(
    `vitrine: descrição é tudo ou nada — ${described} de ${items.length} itens têm a frase. ` +
      'Complete os que faltam ou apague todas: meia lista descrita lê como página inacabada.',
  )
}
const showText = described === items.length

const groupIds = new Set(groups.map((group) => group.id))
for (const item of items) {
  // Com grupos, item sem grupo não cai em aba nenhuma e sumiria da página em silêncio.
  if ((groups.length || item.group) && !groupIds.has(item.group)) {
    throw new Error(
      item.group
        ? `vitrine: o item "${item.id}" aponta para o grupo "${item.group}", que não existe em groups.`
        : `vitrine: o item "${item.id}" está sem grupo — com groups preenchido, todo item aponta para um deles.`,
    )
  }
}

/** Com grupos, uma aba por grupo; sem grupos, um painel só, sem abas. */
const tabbed = groups.length > 0
const shelves = tabbed
  ? groups.map((group) => ({
      id: group.id,
      label: group.label,
      items: items.filter((item) => item.group === group.id),
    }))
  : [{ id: 'todos', label: showcase.title, items: [...items] }]

for (const shelf of shelves) {
  if (!shelf.items.length) {
    throw new Error(
      `vitrine: o grupo "${shelf.id}" está sem itens. Remova o grupo ou aponte itens para ele.`,
    )
  }
}

const countLabel = (n: number) => `${n} ${n === 1 ? 'modelo' : 'modelos'}`

/** O card mostra a marca em cima e o modelo em destaque: "Markem-Imaje 9018" → "9018". */
const modelOf = (title: string) =>
  title.startsWith(`${showcase.brand} `) ? title.slice(showcase.brand.length + 1) : title

/** Número curto em destaque; nome longo desce de tamanho para caber no card. */
const modelSize = (model: string) =>
  model.length <= 6
    ? 'text-[1.9rem] sm:text-[2.1rem]'
    : model.length <= 12
      ? 'text-[1.45rem]'
      : 'text-[1.15rem]'
---

<Section id="vitrine" tone={tone} rhythm={rhythm} data-showcase>
  <div class="max-w-4xl">
    <span class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.22em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-[3px] w-6 rounded-full bg-accent-orange"></span>
      {showcase.eyebrow}
    </span>
    <h2 class="mt-3 font-display text-3xl leading-[1.08] font-extrabold tracking-[-0.025em] text-ink sm:text-4xl lg:text-[2.9rem]">
      {showcase.title}
    </h2>
    <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px]">
      {showcase.text}
    </p>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-4">
    {tabbed && (
      <div
        role="tablist"
        aria-label="Tecnologias"
        class="scroll-track -mx-6 flex max-w-[calc(100%+3rem)] gap-3 overflow-x-auto px-6 pb-1 sm:mx-0 sm:max-w-full sm:px-0"
      >
        {shelves.map((shelf, i) => (
          <button
            type="button"
            role="tab"
            id={`vitrine-aba-${shelf.id}`}
            aria-controls={`vitrine-painel-${shelf.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-showcase-tab
            data-count={countLabel(shelf.items.length)}
            class="shrink-0 rounded-lg border border-neutral-gray-200/80 bg-neutral-light px-5 py-3 font-sans text-[15px] font-medium whitespace-nowrap text-ink transition-colors duration-200 hover:border-primary-dark/40 aria-selected:border-primary-dark aria-selected:bg-primary-dark aria-selected:font-semibold aria-selected:text-neutral-light sm:px-8 sm:text-base"
          >
            {shelf.label}
          </button>
        ))}
      </div>
    )}
    <span
      class="ml-auto shrink-0 font-sans text-[12px] font-semibold tracking-[0.22em] text-ink-soft uppercase"
      aria-live="polite"
      data-showcase-count
    >
      {countLabel(shelves[0].items.length)}
    </span>
  </div>

  {shelves.map((shelf, i) => (
    <div
      role={tabbed ? 'tabpanel' : undefined}
      id={`vitrine-painel-${shelf.id}`}
      aria-labelledby={tabbed ? `vitrine-aba-${shelf.id}` : undefined}
      hidden={i !== 0}
      data-showcase-panel
      class="showcase-panel mt-6"
    >
      <ul
        data-showcase-rail
        aria-label={shelf.label}
        class="scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:scroll-px-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      >
        {shelf.items.map((item) => {
          const model = modelOf(item.title)
          return (
            <li class="w-[66%] shrink-0 snap-start sm:w-[40%] lg:w-auto">
              <button
                type="button"
                data-cta={`vitrine-${item.id}`}
                class="btn-slave-whats showcase-card group flex h-full w-full flex-col overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light text-left shadow-[0_18px_40px_-28px_rgba(6,67,55,0.45)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(6,67,55,0.6)]"
              >
                <span class="showcase-card__stage flex aspect-[4/3] items-center justify-center overflow-hidden">
                  <Image
                    src={item.photo.src}
                    alt={item.photo.alt}
                    format="webp"
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 240px, (min-width: 640px) 40vw, 66vw"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain p-3 transition-transform duration-500 ease-out group-hover:scale-[1.05]"
                  />
                </span>

                <span class="showcase-card__panel flex flex-1 flex-col px-4 pt-4 pb-4 sm:px-5">
                  <span class="font-sans text-[10.5px] font-bold tracking-[0.18em] text-neutral-light/85 uppercase">
                    {showcase.brand}
                  </span>
                  <span
                    class:list={[
                      'mt-0.5 font-display leading-[1.12] font-extrabold tracking-[-0.01em] text-neutral-light',
                      modelSize(model),
                    ]}
                  >
                    {model}
                  </span>
                  {showText && (
                    <span class="mt-1.5 font-sans text-[12.5px] leading-relaxed text-neutral-light/75">
                      {item.description}
                    </span>
                  )}
                  <span aria-hidden="true" class="min-h-3 flex-1" />
                  <span class="flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                    <span class="font-sans text-[13.5px] text-neutral-light/90">
                      {showcase.itemCta}
                    </span>
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light transition-transform duration-300 group-hover:translate-x-0.5">
                      <Icon name="arrow-right" class="size-4" />
                    </span>
                  </span>
                </span>
              </button>
            </li>
          )
        })}
      </ul>

      {shelf.items.length > 1 && (
        <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
          <button
            type="button"
            data-rail-prev
            aria-label={`Modelo anterior de ${shelf.label}`}
            class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
          >
            <Icon name="chevron-right" class="size-4 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label={`Próximo modelo de ${shelf.label}`}
            class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
          >
            <Icon name="chevron-right" class="size-4" />
          </button>
        </div>
      )}
    </div>
  ))}

  <div class="mt-10 flex flex-col gap-3 border-t border-neutral-gray-200/80 pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p class="font-display text-lg leading-snug font-bold text-ink sm:text-xl lg:text-[22px]">
      {showcase.help.text}
    </p>
    <button
      type="button"
      data-cta="vitrine-ajuda"
      class="btn-slave-whats group inline-flex shrink-0 items-center gap-2 self-start font-sans text-[15px] font-semibold text-primary-dark underline decoration-1 underline-offset-[5px] transition-colors duration-200 hover:text-accent-orange sm:self-auto"
    >
      {showcase.help.cta}
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    </button>
  </div>
</Section>

<style>
  /* Palco claro da foto: o recorte do produto pousa sobre um cinza que clareia para baixo. */
  .showcase-card__stage {
    background-image: linear-gradient(180deg, #f3f6f5 0%, #ffffff 100%);
  }

  /* Painel verde-escuro do card, com um brilho sutil no topo. */
  .showcase-card__panel {
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.07) 0%, transparent 60%),
      linear-gradient(
        165deg,
        var(--color-primary-dark-800) 0%,
        var(--color-primary-dark) 55%,
        var(--color-primary-dark-900) 100%
      );
  }

  /* Troca de aba: o painel novo entra subindo 6px. */
  .showcase-panel:not([hidden]) {
    animation: showcase-in 320ms ease-out;
  }

  @keyframes showcase-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-panel:not([hidden]) {
      animation: none;
    }

    .showcase-card,
    .showcase-card * {
      transition: none !important;
    }

    .showcase-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-showcase-tab]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-showcase-panel]')]
    const count = root.querySelector<HTMLElement>('[data-showcase-count]')

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
      })
      panels.forEach((panel, i) => {
        panel.hidden = i !== index
      })
      if (count) count.textContent = tabs[index].dataset.count ?? ''
      if (focus) tabs[index].focus()
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i))
      // Setas, Home e End movem entre as abas (roving tabindex).
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1
        const to =
          event.key === 'ArrowRight'
            ? i === last
              ? 0
              : i + 1
            : event.key === 'ArrowLeft'
              ? i === 0
                ? last
                : i - 1
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : -1
        if (to < 0) return
        event.preventDefault()
        select(to, true)
      })
    })

    // Trilho do mobile: setas que rolam um card por vez.
    panels.forEach((panel) => {
      const rail = panel.querySelector<HTMLElement>('[data-showcase-rail]')
      const prev = panel.querySelector<HTMLButtonElement>('[data-rail-prev]')
      const next = panel.querySelector<HTMLButtonElement>('[data-rail-next]')
      if (!rail || !prev || !next) return

      const step = () => {
        const card = rail.querySelector<HTMLElement>('li')
        return card ? card.offsetWidth + 16 : rail.clientWidth * 0.8
      }
      const go = (dir: number) =>
        rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' })

      prev.addEventListener('click', () => go(-1))
      next.addEventListener('click', () => go(1))
    })
  })
</script>
