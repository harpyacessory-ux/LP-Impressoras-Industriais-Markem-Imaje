---
/**
 * "Como funciona" — fase "apoio" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, pedido de 27/10/2026 (docs/BRIEFING.md): o painel das etapas
 * deu lugar ao banner enviado pelo usuário. O banner inteiro é o CTA (`processo-cta`); no
 * celular entra o recorte do lado do texto. É o bloco escuro da primeira metade da página.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor, reaplique.
 */
import { getImage } from 'astro:assets'
import Section from '@components/Section.astro'
import type { SectionProps } from '@lib/layout'
import { process } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const desktop = await Promise.all(
  [640, 1024, 1536, 1870].map((width) =>
    getImage({ src: process.banner.src, width, format: 'webp' }),
  ),
)
const mobile = await Promise.all(
  [400, 800].map((width) => getImage({ src: process.bannerMobile.src, width, format: 'webp' })),
)
const srcset = (images: typeof desktop) =>
  images.map((img) => `${img.src} ${img.attributes.width}w`).join(', ')
---

<Section id="processo" tone={tone} rhythm={rhythm}>
  <h2 class="sr-only">{process.title}</h2>

  <button
    type="button"
    data-cta="processo-cta"
    class="btn-slave-whats group block w-full overflow-hidden rounded-2xl bg-hero-deep text-left shadow-[0_30px_60px_-34px_rgba(1,36,34,0.75)] ring-1 ring-brand-glow/15 transition-shadow duration-300 hover:shadow-[0_36px_70px_-30px_rgba(26,165,122,0.6)]"
  >
    <picture>
      <source media="(max-width: 639px)" type="image/webp" srcset={srcset(mobile)} sizes="100vw" />
      <source
        type="image/webp"
        srcset={srcset(desktop)}
        sizes="(min-width: 1320px) 1240px, calc(100vw - 48px)"
      />
      <img
        src={desktop[2].src}
        alt={process.banner.alt}
        width={process.banner.src.width}
        height={process.banner.src.height}
        loading="lazy"
        decoding="async"
        class="process-banner block h-auto w-full transition-[filter] duration-300 group-hover:brightness-105"
      />
    </picture>
  </button>
</Section>

<style>
  /* Proporção de cada recorte reservada antes da imagem chegar (sem deslocar a página). */
  .process-banner {
    aspect-ratio: 800 / 720;
  }

  @media (min-width: 640px) {
    .process-banner {
      aspect-ratio: 1870 / 841;
    }
  }
</style>
