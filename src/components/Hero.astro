---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), com o desvio visual do mockup de abertura da
 * Print Master (26/10/2026 — docs/BRIEFING.md): fundo verde-escuro, H1 com a marca em menta,
 * pontos sem caixa, botões arredondados e o 9750 grande, com halo e arcos de luz.
 *
 * Grid desktop: texto (--text-col) · janela do equipamento (1fr) · shortcode do chat (300px).
 * O equipamento está no centro do banner (50% da largura), e esse centro é ancorado no centro
 * da coluna 2, em qualquer largura de tela. No mobile o banner vira um quadro sob o texto.
 * Abra a página com `?grid=1` para ver as colunas.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV

// O H1 continua sendo `hero.title` (é ele que o check:lp confere); o destaque só quebra linha.
const at = hero.title.indexOf(hero.highlight)
const titleBefore = at >= 0 ? hero.title.slice(0, at) : hero.title
const titleAfter = at >= 0 ? hero.title.slice(at + hero.highlight.length) : ''
---

<section
  class="hero relative isolate overflow-hidden border-b border-white/10 bg-primary-dark-900"
  data-hero
>
  {/* conteúdo — sem `relative` no contêiner: no desktop o banner se posiciona pelo hero */}
  <div class="mx-auto max-w-page px-6 pt-12 pb-14 lg:px-10 lg:py-20">
    <div class="hero-grid grid items-center gap-y-10 lg:gap-x-8">
      {/* Coluna 1 — textos */}
      <div class="relative z-[3] max-w-xl lg:max-w-none">
        <span class="inline-flex items-center gap-3 font-sans text-[12.5px] font-semibold tracking-[0.22em] text-brand-glow uppercase">
          <span aria-hidden="true" class="h-[2px] w-10 rounded-full bg-brand-glow"></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-5 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[3.2rem] lg:text-[2.3rem] xl:text-[3.25rem]">
          {titleBefore}
          {at >= 0 && <span class="block text-brand-glow">{hero.highlight}</span>}
          {titleAfter}
        </h1>

        <p class="mt-6 max-w-[34rem] font-sans text-[17px] leading-relaxed text-neutral-light/75 lg:text-lg">
          {hero.text}
        </p>

        {/* 3 pontos — ícone menta solto e texto sempre em duas linhas */}
        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-5" aria-label="Destaques">
          {hero.points.map((point) => (
            <li class="hero-point flex items-center gap-3">
              <Icon name={point.icon} class="size-9 shrink-0 text-brand-glow" />
              <span class="font-sans text-[15px] leading-snug text-neutral-light/90">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-cta="hero-primary"
            class="btn-slave-whats inline-flex items-center justify-center gap-3 rounded-lg bg-brand-emerald px-6 py-4 font-sans text-base font-semibold text-neutral-light shadow-[0_18px_40px_-18px_rgba(7,134,90,0.95)] transition-colors duration-200 hover:bg-accent-orange lg:text-[15px] xl:text-base"
          >
            {cta.primary}
            <Icon name="arrow-right" class="size-5 shrink-0" />
          </button>
          <button
            type="button"
            data-cta="hero-secondary"
            class="btn-slave-whats inline-flex items-center justify-center gap-3 rounded-lg border border-neutral-light/45 px-6 py-4 font-sans text-base font-medium text-neutral-light transition-colors duration-200 hover:bg-neutral-light/10 lg:text-[15px] xl:text-base"
          >
            <Icon name="search" class="size-5 shrink-0" />
            {cta.secondary}
          </button>
        </div>
      </div>

      {/* Coluna 2 — janela do equipamento (no mobile, o quadro do banner) */}
      <div class="hero-window">
        <div class="hero-photo">
          <Picture
            src={hero.banner.src}
            alt={hero.banner.alt}
            widths={[640, 1024, 1536, 1981]}
            sizes="(min-width: 1024px) 1536px, 220vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero-photo-img"
            pictureAttributes={{ class: 'block h-full' }}
          />
        </div>
        <span class="hero-caption font-sans text-[13px] text-neutral-light/70">{hero.caption}</span>
      </div>

      {/* Coluna 3 — shortcode do chat (300px) */}
      <div class="hero-chat relative z-[3] w-full lg:w-[300px]" data-shortcode-slot>
        <slot name="shortcode">
          {isDev ? (
            <div
              class="flex min-h-[430px] w-full flex-col gap-3 rounded-2xl border border-white/15 bg-neutral-light p-4 text-left"
              aria-label="Mock do chat (só em desenvolvimento)"
            >
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Mock · chat
              </span>
              <p class="font-display text-base font-bold text-ink">Fale com um especialista</p>
              <div class="h-10 rounded-lg bg-neutral-gray-100" />
              <div class="h-10 rounded-lg bg-neutral-gray-100" />
              <div class="h-24 rounded-lg bg-neutral-gray-100" />
              <div class="mt-auto h-11 rounded-lg bg-brand-emerald" />
            </div>
          ) : (
            <div class="flex min-h-[430px] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-neutral-light/35 bg-primary-dark-900/80 p-6 text-center backdrop-blur-sm">
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-glow uppercase">
                Espaço reservado
              </span>
              <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 300px</p>
            </div>
          )}
        </slot>
      </div>
      {/*
        Fora do WordPress o shortcode chega como texto cru ("[atendimento_chat …]"). Este script
        roda durante o parse, antes da primeira pintura, e esconde o espaço — sem deslocar nada.
        No WordPress o plugin já trocou o shortcode pelo chat e o script não faz nada.
      */}
      <script is:inline>
        ;(() => {
          const slot = document.currentScript?.previousElementSibling
          if (!slot || /wordpress|printmaster\.net\.br/i.test(location.hostname)) return
          if (slot.children.length === 0 && /^\[[^\]]+\]$/.test(slot.textContent.trim()))
            slot.hidden = true
        })()
      </script>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-8">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x-2 border-dashed border-brand-glow bg-brand-glow/5 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-glow">
            col 2 · janela do equipamento
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Medidas que amarram as colunas e o banner ao mesmo eixo. */
  .hero {
    --text-col: 420px;
    --chat-col: 300px;
    --col-gap: 2rem;
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Largura útil do contêiner (sem o px-10) e centro da coluna 2, a partir da borda da tela. */
    --inner: calc(min(100%, var(--container-page)) - 80px);
    --window-center: calc(
      var(--page-edge) + 40px + var(--text-col) + var(--col-gap) +
        (var(--inner) - var(--text-col) - var(--chat-col) - 2 * var(--col-gap)) / 2
    );
    /* Deslocamento do equipamento a partir do centro da janela (só na faixa estreita). */
    --photo-shift: 0px;
  }

  /* Divisórias sutis entre os destaques (a partir de tablet). */
  /* Fora de 1024–1279px os três cabem numa linha; nessa faixa a coluna é estreita e o terceiro
     desce, então ali não há divisória. */
  @media (width >= 40rem) and (width < 64rem), (width >= 80rem) {
    .hero-point + .hero-point {
      padding-left: 1.5rem;
      border-left: 1px solid rgb(255 255 255 / 0.16);
    }
  }

  /* Mobile: o banner é um quadro sob o texto, centrado no equipamento. */
  .hero-window {
    position: relative;
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-width: 520px;
    margin-inline: auto;
    /* Elíptica: o quadro se dissolve no fundo pelos quatro lados, sem borda visível. */
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, black 64%, transparent 100%);
  }

  .hero-photo :global(.hero-photo-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  .hero-caption {
    position: absolute;
    right: 1rem;
    bottom: 1.25rem;
    z-index: 3;
  }

  @media (min-width: 1024px) {
    /* Col 1 texto | Col 2 janela do equipamento | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) var(--chat-col);
    }

    .hero {
      min-height: 640px;
    }

    .hero-window {
      position: static;
      align-self: stretch;
    }

    /* O banner cobre a altura do hero; o equipamento cai no centro da coluna 2. */
    .hero-photo {
      position: absolute;
      inset-block: 0;
      left: calc(var(--window-center) + var(--photo-shift));
      z-index: 1;
      max-width: none;
      margin: 0;
      aspect-ratio: auto;
      transform: translateX(-50%);
      mask-image: linear-gradient(to right, transparent 0, black 16%, black 84%, transparent 100%);
    }

    .hero-photo :global(.hero-photo-img) {
      width: auto;
      max-width: none;
      height: 100%;
    }

    .hero-caption {
      right: auto;
      bottom: 3.5rem;
      left: calc(var(--window-center) + var(--photo-shift) + 185px);
    }
  }

  /* 1024–1279px: a janela é estreita; o equipamento desliza para a direita, para não passar
     por trás do texto. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero {
      --photo-shift: 70px;
    }
  }

  @media (min-width: 1280px) {
    .hero {
      /* Cabe "Impressoras industriais" numa linha do H1, como no mockup. */
      --text-col: 600px;
      --photo-shift: 20px;
      min-height: 680px;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
