---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), com o desvio visual do mockup de abertura da
 * Print Master (26/10/2026 — docs/BRIEFING.md): fundo verde-escuro, H1 em três linhas com a
 * marca em menta, pontos sem caixa, um botão em pílula e um link para a vitrine, o 9410 e o
 * 9750 lado a lado sob o selo da Markem-Imaje, e a prévia do chat na coluna do shortcode.
 *
 * Grid desktop: texto (--text-col) · janela dos equipamentos (1fr) · shortcode do chat (300px).
 * O par de equipamentos está no centro do banner (50% da largura), e esse centro é ancorado no
 * centro da coluna 2, em qualquer largura de tela. No mobile o banner vira um quadro sob o texto.
 * Abra a página com `?grid=1` para ver as colunas.
 */
import { Image, Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta, chatPreview } from '../data/content'

const isDev = import.meta.env.DEV

// O H1 continua sendo `hero.title` (é ele que o check:lp confere); o destaque só quebra linha.
const at = hero.title.indexOf(hero.highlight)
const titleBefore = at >= 0 ? hero.title.slice(0, at) : hero.title
const titleAfter = at >= 0 ? hero.title.slice(at + hero.highlight.length) : ''
---

<section
  class="hero relative isolate overflow-hidden border-b border-white/10 bg-hero-deep"
  data-hero
>
  {/* conteúdo — sem `relative` no contêiner: no desktop o banner se posiciona pelo hero */}
  <div class="mx-auto max-w-page px-6 pt-12 pb-14 lg:px-10 lg:py-14">
    <div class="hero-grid grid items-center gap-y-10 lg:gap-x-8">
      {/* Coluna 1 — textos */}
      <div class="relative z-[3] max-w-xl lg:max-w-none">
        <span class="inline-flex items-center gap-3 font-sans text-[12px] font-medium tracking-[0.2em] text-brand-glow uppercase sm:text-[12.5px]">
          <span aria-hidden="true" class="h-[3px] w-9 rounded-full bg-brand-glow"></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-4 font-display text-[2.75rem] leading-[0.98] font-extrabold tracking-[-0.04em] text-neutral-light sm:text-[3.6rem] lg:text-[3rem] xl:text-[4.15rem]">
          {titleBefore}
          {at >= 0 && <span class="block text-brand-glow">{hero.highlight}</span>}
          {titleAfter}
        </h1>

        <p class="mt-5 max-w-[31rem] font-sans text-[17px] leading-relaxed text-neutral-light/80 lg:text-lg xl:text-[19px]">
          {hero.text}
        </p>

        {/* 3 pontos — ícone menta solto e texto sempre em duas linhas */}
        <ul
          class="mt-7 grid grid-cols-3 gap-x-3 sm:flex sm:flex-nowrap lg:grid xl:flex"
          aria-label="Destaques"
        >
          {hero.points.map((point) => (
            <li class="hero-point flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-2.5 lg:flex-col lg:items-start lg:gap-2 xl:flex-row xl:items-center xl:gap-2.5">
              <Icon name={point.icon} class="size-8 shrink-0 text-brand-glow" />
              <span class="font-sans text-[13.5px] leading-snug text-neutral-light/90">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <button
          type="button"
          data-cta="hero-primary"
          class="btn-slave-whats mt-8 inline-flex items-center justify-center gap-3 rounded-full bg-brand-emerald bg-[linear-gradient(180deg,#0a8f61_0%,#06784f_100%)] px-8 py-4 font-sans text-[17px] font-bold xl:px-10 xl:py-[1.15rem] xl:text-[19px] text-neutral-light shadow-[0_18px_44px_-16px_rgba(26,165,122,0.85)] ring-1 ring-brand-glow/30 transition-[filter] duration-200 ring-inset hover:brightness-110"
        >
          {cta.primary}
          <Icon name="whatsapp" class="size-6 shrink-0 xl:size-7" />
          <Icon name="arrow-right" class="size-5 shrink-0" />
        </button>

        <a
          href="#vitrine"
          data-cta="hero-secondary"
          class="group mt-6 flex w-fit items-center gap-3 border-b border-neutral-light/45 pb-1.5 font-sans text-base text-neutral-light/90 xl:text-[17px] transition-colors duration-200 hover:border-brand-glow hover:text-brand-glow"
        >
          {hero.link}
          <Icon
            name="arrow-right"
            class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      {/* Coluna 2 — janela dos equipamentos (no mobile, o quadro do banner) */}
      <div class="hero-window">
        <div class="hero-badge">
          <Image
            src={hero.badge.src}
            alt={hero.badge.alt}
            width={220}
            height={50}
            format="webp"
            loading="eager"
            decoding="async"
            class="h-8 w-auto sm:h-10 xl:h-11"
          />
        </div>
        <div class="hero-photo">
          <Picture
            src={hero.banner.src}
            alt={hero.banner.alt}
            widths={[640, 1024, 1536, 1752]}
            sizes="(min-width: 1024px) 1720px, 220vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero-photo-img"
            pictureAttributes={{ class: 'block h-full' }}
          />
        </div>
      </div>

      {/* Coluna 3 — shortcode do chat (300px) */}
      <div class="hero-chat relative z-[3] w-full lg:w-[300px]" data-shortcode-slot>
        <slot name="shortcode">
          {isDev ? (
            <div
              class="flex min-h-[430px] w-full flex-col gap-3 rounded-2xl border border-white/15 bg-neutral-light p-4 text-left"
              aria-label="Mock do chat (só em desenvolvimento)"
            >
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Mock · chat
              </span>
              <p class="font-display text-base font-bold text-ink">Fale com um especialista</p>
              <div class="h-10 rounded-lg bg-neutral-gray-100" />
              <div class="h-10 rounded-lg bg-neutral-gray-100" />
              <div class="h-24 rounded-lg bg-neutral-gray-100" />
              <div class="mt-auto h-11 rounded-lg bg-brand-emerald" />
            </div>
          ) : (
            <div class="flex min-h-[430px] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-neutral-light/35 bg-primary-dark-900/80 p-6 text-center backdrop-blur-sm">
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-glow uppercase">
                Espaço reservado
              </span>
              <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 300px</p>
            </div>
          )}
        </slot>
      </div>
      {/* Prévia do chat: só entra no lugar do shortcode cru, fora do WordPress (script abaixo). */}
      <template>
        <div class="overflow-hidden rounded-2xl border border-brand-glow/25 bg-neutral-light shadow-[0_30px_60px_-28px_rgba(0,0,0,0.75)]">
          <div class="flex items-center gap-3 bg-primary-dark px-4 py-5">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light">
              <Icon name="whatsapp" class="size-7" />
            </span>
            <span class="min-w-0">
              <span class="block font-display text-[16px] leading-tight font-bold text-neutral-light">
                {chatPreview.title}
              </span>
              <span class="mt-0.5 block font-sans text-[13px] text-brand-glow">
                {chatPreview.subtitle}
              </span>
            </span>
          </div>
          <div class="bg-[#f3f7f5] p-4">
            <p class="max-w-[90%] rounded-2xl rounded-tl-sm bg-neutral-light px-4 py-3 font-sans text-[14px] leading-snug text-ink shadow-[0_6px_16px_-10px_rgba(6,67,55,0.35)]">
              {chatPreview.greeting}
            </p>
            <p class="mt-4 font-sans text-[13px] font-medium text-ink">{chatPreview.prompt}</p>
            <div class="mt-2.5 grid grid-cols-2 gap-2">
              {chatPreview.options.map((option) => (
                <button
                  type="button"
                  data-cta={`hero-chat-${option.id}`}
                  class="btn-slave-whats flex items-center gap-2 rounded-lg border border-primary-dark/20 bg-neutral-light px-2.5 py-3.5 text-left font-sans text-[13.5px] text-ink transition-colors duration-200 hover:border-accent-orange hover:text-accent-orange"
                >
                  <Icon name={option.icon} class="size-6 shrink-0 text-primary-dark" />
                  {option.label}
                </button>
              ))}
            </div>
            <p class="mt-3 font-sans text-[12px] text-ink-soft">{chatPreview.hint}</p>
            <p class="mt-3 border-t border-ink/10 pt-3 font-sans text-[11px] text-ink-soft">
              {chatPreview.privacy}
            </p>
          </div>
        </div>
      </template>
      {/*
        Fora do WordPress o shortcode chega como texto cru ("[atendimento_chat …]"). Este script
        roda durante o parse, antes da primeira pintura, e troca o texto pela prévia do chat — sem
        deslocar nada. No WordPress o plugin já trocou o shortcode e o script não faz nada.
      */}
      <script is:inline>
        ;(() => {
          const preview = document.currentScript?.previousElementSibling
          const slot = preview?.previousElementSibling
          if (!slot || !preview || /wordpress|printmaster\.net\.br/i.test(location.hostname)) return
          if (slot.children.length === 0 && /^\[[^\]]+\]$/.test(slot.textContent.trim()))
            slot.replaceChildren(preview.content.cloneNode(true))
        })()
      </script>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-8">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x-2 border-dashed border-brand-glow bg-brand-glow/5 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-glow">
            col 2 · janela dos equipamentos
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Medidas que amarram as colunas e o banner ao mesmo eixo. */
  .hero {
    --text-col: 400px;
    --chat-col: 300px;
    --col-gap: 2rem;
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Largura útil do contêiner (sem o px-10) e centro da coluna 2, a partir da borda da tela. */
    --inner: calc(min(100%, var(--container-page)) - 80px);
    --window-center: calc(
      var(--page-edge) + 40px + var(--text-col) + var(--col-gap) +
        (var(--inner) - var(--text-col) - var(--chat-col) - 2 * var(--col-gap)) / 2
    );
    /* Largura do banner: o par (36,8% da imagem) ocupa o espaço entre o texto e o chat. */
    /* Em vw (não %) para a mesma conta servir também ao `top` do selo. */
    --photo-w: calc(
      (min(100vw, var(--container-page)) - 80px - var(--text-col) - var(--chat-col)) / 0.35
    );
  }

  /* Divisórias sutis entre os destaques. */
  .hero-point + .hero-point {
    padding-left: 0.75rem;
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  /* Mobile: o selo e o banner formam um quadro sob o texto, centrado nos equipamentos. */
  .hero-window {
    position: relative;
  }

  .hero-badge {
    position: relative;
    z-index: 3;
    width: fit-content;
    margin: 0 auto -2.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 0.75rem;
    background: var(--color-neutral-light);
    box-shadow: 0 20px 40px -22px rgb(0 0 0 / 0.75);
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-width: 520px;
    margin-inline: auto;
    /* Elíptica: o quadro se dissolve no fundo pelos quatro lados, sem borda visível. */
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, black 64%, transparent 100%);
  }

  .hero-photo :global(.hero-photo-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52.5% 72%;
  }

  @media (min-width: 1024px) {
    /* Col 1 texto | Col 2 janela dos equipamentos | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) var(--chat-col);
    }

    .hero {
      min-height: 680px;
    }

    .hero-window {
      position: static;
      align-self: stretch;
    }

    /* Banner pela base, na largura --photo-w; o par, a 52,5% da imagem, cai no centro da col. 2. */
    .hero-photo {
      position: absolute;
      top: auto;
      bottom: 0;
      width: var(--photo-w);
      left: calc(var(--window-center));
      z-index: 1;
      max-width: none;
      margin: 0;
      aspect-ratio: auto;
      transform: translateX(-52.5%);
      /* Esmaece as laterais e o topo: com o banner encolhido, a borda de cima não vira linha. */
      mask-image:
        linear-gradient(to right, transparent 0, black 10%, black 90%, transparent 100%),
        linear-gradient(to bottom, transparent 0, black 18%);
      mask-composite: intersect;
    }

    .hero-photo :global(.hero-photo-img) {
      width: 100%;
      max-width: none;
      height: auto;
    }

    /* Selo a 19% da altura da imagem (1752×898), acima dos equipamentos, como no mockup. */
    /* Altura da imagem = --photo-w / 1,951; 81,1% dela fica abaixo do selo. */
    .hero-badge {
      position: absolute;
      top: calc(100% - var(--photo-w) * 0.4157);
      left: var(--window-center);
      margin: 0;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1280px) {
    .hero {
      /* Cabe "Markem-Imaje" numa linha do H1 em 4,15rem, como no mockup. */
      --text-col: 440px;
      min-height: 700px;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
