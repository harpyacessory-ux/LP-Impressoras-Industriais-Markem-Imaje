---
/**
 * Botão flutuante de WhatsApp.
 *
 * Com `whatsapp` preenchido em site.ts, é o único CTA da página com href (abre a conversa
 * direto). Print Master (mockup de 26/10/2026, docs/BRIEFING.md): sem número informado, o botão
 * aparece mesmo assim, como `button.btn-slave-whats` — o plugin de atendimento do WordPress
 * captura o clique, como em todos os outros CTAs. Nos dois casos leva data-cta.
 */
import Icon from './Icon.astro'

interface Props {
  number?: string
}

const { number = '' } = Astro.props
const Tag = number ? 'a' : 'button'
const attrs = number
  ? { href: `https://wa.me/${number}`, target: '_blank', rel: 'noopener noreferrer' }
  : { type: 'button' as const }
---

<Tag
  {...attrs}
  data-cta="float-whatsapp"
  aria-label="Conversar pelo WhatsApp"
  class:list={[
    !number && 'btn-slave-whats',
    'fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full border-4 border-neutral-light bg-[#25d366] text-neutral-light shadow-[0_14px_30px_-10px_rgba(0,0,0,0.5)] transition-transform duration-200 hover:scale-105 sm:right-6 sm:bottom-6 sm:size-16',
  ]}
>
  <Icon name="whatsapp" class="size-7 sm:size-8" />
</Tag>

<style>
  @media (prefers-reduced-motion: reduce) {
    a,
    button {
      transition: none;
    }
    a:hover,
    button:hover {
      transform: none;
    }
  }
</style>
