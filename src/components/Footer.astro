---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.5). Uma linha: copyright · endereço · crédito da B2.
 * Sem menu, redes, telefone, e-mail, logo ou formulário.
 *
 * Print Master (mockup de 27/10/2026, docs/BRIEFING.md): fundo verde quase preto, alfinete em
 * menta e textos mais claros; o resto é o do padrão.
 */
import Icon from './Icon.astro'
import { site } from '../data/site'
import { footer } from '../data/content'

const year = new Date().getFullYear()
---

<footer class="footer-deep navy-premium border-t border-white/15">
  <div class="mx-auto flex max-w-page flex-col items-center gap-3 px-6 py-6 text-center lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-10 lg:text-left">
    <p class="shrink-0 font-sans text-xs text-neutral-light/70">
      © {year} {site.brand}. Todos os direitos reservados.
    </p>

    <address class="flex items-center gap-2 font-sans text-xs text-neutral-light/85 not-italic lg:whitespace-nowrap">
      <Icon name="map-pin" class="size-4 shrink-0 text-brand-glow" />
      <span>{site.address}</span>
    </address>

    <p class="shrink-0 font-sans text-xs text-neutral-light/70">
      Desenvolvido por{' '}
      <a
        href={footer.credit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-neutral-light transition-colors hover:text-brand-glow"
      >
        {footer.credit.label}
      </a>
    </p>
  </div>
</footer>

<style>
  /* Mais escuro que o navy-premium do padrão, como no mockup. */
  .footer-deep {
    background: #0b201b;
  }
</style>
